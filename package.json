{
  "name": "antrian-bank-desktop",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:kiosk": "set APP_MODE=kiosk&& electron .",
    "start:display": "set APP_MODE=display&& electron .",
    "start:operator": "set APP_MODE=operator&& electron .",
    "start:admin": "set APP_MODE=admin&& electron .",
    "postinstall": "electron-rebuild -f -w sqlite3",
    "build:kiosk": "set APP_MODE=kiosk&& electron-builder --win --x64 --config.extraMetadata.name=antrian-kiosk --config.productName=\"Antrian Kiosk\"",
    "build:display": "set APP_MODE=display&& electron-builder --win --x64 --config.extraMetadata.name=antrian-display --config.productName=\"Antrian Display\"",
    "build:operator": "set APP_MODE=operator&& electron-builder --win --x64 --config.extraMetadata.name=antrian-operator --config.productName=\"Antrian Operator\"",
    "build:admin": "set APP_MODE=admin&& electron-builder --win --x64 --config.extraMetadata.name=antrian-admin --config.productName=\"Antrian Admin\""
  },
  "dependencies": {
    "body-parser": "^2.2.1",
    "cors": "^2.8.5",
    "electron": "^29.4.6",
    "express": "^5.2.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9"
  }
}
